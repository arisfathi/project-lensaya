{
	email {$ACME_EMAIL}
}

{$BASE_DOMAIN}, www.{$BASE_DOMAIN}, app.{$BASE_DOMAIN}, admin.{$BASE_DOMAIN}, *.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	# NOTE: use `handle` blocks for *all* routing so that the SPA file server
	# does not short-circuit API/health requests.

	@www host www.{$BASE_DOMAIN}
	handle @www {
		redir https://{$BASE_DOMAIN}{uri} 308
	}

	handle /health* {
		reverse_proxy backend:4000
	}

	handle /api/* {
		reverse_proxy backend:4000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
