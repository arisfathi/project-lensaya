# Production env template (Docker Compose + Caddy, single Droplet)
# On your server:
#   cp .env.production.example .env
#   nano .env
#   chmod 600 .env

# -----------------------------
# Caddy / TLS (Cloudflare DNS)
# -----------------------------
BASE_DOMAIN=lensaya.com
ACME_EMAIL=replace-with-your-email
# Cloudflare API Token with Zone:DNS:Edit on BASE_DOMAIN
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# -----------------------------
# Postgres (container)
# -----------------------------
POSTGRES_USER=postgres
POSTGRES_DB=lensaya
POSTGRES_PASSWORD=replace-with-strong-password

# -----------------------------
# Backend core
# -----------------------------
NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-strong-jwt-secret

# IMPORTANT: password must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://postgres:replace-with-strong-password@db:5432/lensaya?schema=public

# Redis for queues/workers
REDIS_URL=redis://redis:6379

# -----------------------------
# Platform URLs (app on apex)
# -----------------------------
APP_URL=https://lensaya.com
PUBLIC_APP_URL=https://lensaya.com
ADMIN_APP_URL=https://admin.lensaya.com
CORS_ORIGINS=https://lensaya.com,https://admin.lensaya.com

# -----------------------------
# Auth cookies (shared across apex + admin + subdomains)
# -----------------------------
AUTH_COOKIE_DOMAIN=.lensaya.com
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true

# -----------------------------
# Storage (Cloudflare R2)
# -----------------------------
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=lensaya-prod
# Can also be named R2_PUBLIC_URL; backend accepts both
R2_PUBLIC_BASE_URL=replace-with-public-base-url

# -----------------------------
# Billing (Stripe)
# -----------------------------
BILLING_PROVIDER=stripe
STRIPE_API_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_WEBHOOK_TOLERANCE_SEC=300
STRIPE_SUCCESS_URL=https://lensaya.com/checkout/success
STRIPE_CANCEL_URL=https://lensaya.com/checkout/canceled

# Optional but recommended: map plans to Stripe Price IDs (standard SaaS setup).
STRIPE_PRICE_ID_PRO_MONTHLY=replace-with-stripe-price-id
STRIPE_PRICE_ID_PRO_YEARLY=replace-with-stripe-price-id
STRIPE_PRICE_ID_STUDIO_MONTHLY=replace-with-stripe-price-id
STRIPE_PRICE_ID_STUDIO_YEARLY=replace-with-stripe-price-id

# -----------------------------
# Email (optional, Resend)
# -----------------------------
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_FROM_EMAIL=no-reply@lensaya.com

# -----------------------------
# Auth (optional, Google / Apple)
# -----------------------------
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# APPLE_AUTH_ENABLED=true
# APPLE_CLIENT_ID=replace-with-apple-services-id
# APPLE_TEAM_ID=replace-with-apple-team-id
# APPLE_KEY_ID=replace-with-apple-key-id
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-apple-private-key\n-----END PRIVATE KEY-----
# APPLE_REDIRECT_URI=https://lensaya.com

# -----------------------------
# Frontend build-time env (Vite)
# -----------------------------
VITE_APP_BASE_DOMAIN=lensaya.com
VITE_PUBLIC_DIRECTORY_ENABLED=false
# VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
# VITE_APPLE_AUTH_ENABLED=true
# VITE_APPLE_CLIENT_ID=replace-with-apple-services-id
# VITE_APPLE_REDIRECT_URI=https://lensaya.com
# VITE_META_PIXEL_ID=replace-with-facebook-pixel-id
