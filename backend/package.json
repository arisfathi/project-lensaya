{
  "name": "lensaya-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "node --watch server.js",
    "prestart": "npm run prisma:generate",
    "start": "node server.js",
    "test": "node --test --experimental-test-isolation=none --test-concurrency=1",
    "worker:email": "node src/workers/emailWorker.js",
    "worker:analytics": "node src/workers/analyticsWorker.js",
    "worker:image": "node src/workers/imageProcessingWorker.js",
    "worker:asset-cleanup": "node src/workers/assetCleanupWorker.js",
    "worker:notification": "node src/workers/notificationWorker.js",
    "worker:billing-maintenance": "node src/workers/billingMaintenanceWorker.js",
    "backup:postgres": "node scripts/backup-postgres.js",
    "restore:postgres:snapshot": "node scripts/restore-postgres-snapshot.js",
    "backup:r2manifest": "node scripts/backup-r2-manifest.js",
    "backup:daily": "node scripts/run-daily-backups.js",
    "seed:demo:lensaya": "node scripts/seed-lensaya-demo.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "env:check": "node scripts/validate-production-env.js",
    "env:check:production": "node scripts/validate-production-env.js --production",
    "lint": "echo \"No linter configured\""
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.926.0",
    "@aws-sdk/s3-request-presigner": "^3.926.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sentry/node": "^10.42.0",
    "@sentry/profiling-node": "^10.42.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "formidable": "^3.5.4",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.5.2",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
