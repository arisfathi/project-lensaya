generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  emailVerifiedAt     DateTime?
  passwordHash        String?              @db.VarChar(255)
  googleId            String?              @unique @db.VarChar(191)
  fullName            String               @db.VarChar(191)
  username            String?              @unique @db.VarChar(64)
  role                UserRole             @default(PHOTOGRAPHER)
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  adminLogs           AdminLog[]           @relation("AdminActor")
  adminLogsTargeted   AdminLog[]           @relation("AdminTargetUser")
  analyticsEvents     AnalyticsEvent[]
  assetsUploaded      Asset[]              @relation("AssetUploader")
  bookingsAsClient    Booking[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  photographer        Photographer?
  referralsReceived   Referral?            @relation("ReferralsReceived")
  referralsSent       Referral[]           @relation("ReferralsSent")
  subscriptions       Subscription[]
  transactions        Transaction[]

  @@index([role, status])
  @@index([createdAt])
}

model Photographer {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  username           String             @unique @db.VarChar(64)
  studioName         String             @db.VarChar(191)
  bio                String?
  status             PhotographerStatus @default(ACTIVE)
  websiteUrl         String?            @db.VarChar(255)
  themeColor         String?            @db.VarChar(16)
  phone              String?            @db.VarChar(32)
  whatsappNumber     String?            @db.VarChar(32)
  instagramHandle    String?            @db.VarChar(191)
  facebookUrl        String?            @db.VarChar(255)
  tiktokHandle       String?            @db.VarChar(191)
  timezone           String             @default("UTC") @db.VarChar(64)
  currency           String             @default("USD") @db.VarChar(3)
  avatarAssetId      String?            @db.Uuid
  bannerAssetId      String?            @db.Uuid
  heroTitle          String?            @db.VarChar(191)
  heroSubtitle       String?
  heroImageUrl       String?            @db.VarChar(1024)
  heroButtonText     String?            @db.VarChar(191)
  heroButtonLink     String?            @db.VarChar(1024)
  showHero           Boolean            @default(true)
  showTeamSection    Boolean            @default(false)
  teamMembers        Json?
  isDirectoryVisible Boolean            @default(true)
  location           String?            @db.VarChar(191)
  city               String?            @db.VarChar(128)
  country            String?            @db.VarChar(128)
  specialty          String?            @db.VarChar(128)
  style              String?            @db.VarChar(128)
  hideBranding       Boolean            @default(false)
  inquiryGoalTarget  Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  analyticsEvents    AnalyticsEvent[]
  analyticsDailyEventRollups   AnalyticsDailyEventRollup[]
  analyticsDailyServiceRollups AnalyticsDailyServiceRollup[]
  analyticsDailyVisitorRollups AnalyticsDailyVisitorRollup[]
  assets             Asset[]            @relation("PhotographerAssets")
  availabilities     Availability[]
  bookings           Booking[]
  packages           Package[]
  avatarAsset        Asset?             @relation("PhotographerAvatar", fields: [avatarAssetId], references: [id])
  bannerAsset        Asset?             @relation("PhotographerBanner", fields: [bannerAssetId], references: [id])
  customDomain       CustomDomain?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioItems     PortfolioItem[]
  referrals          Referral[]         @relation("ReferralsToPhotographer")
  services           Service[]
  subscriptions      Subscription[]

  @@index([status, createdAt])
  @@index([isDirectoryVisible, createdAt])
  @@index([city, isDirectoryVisible, status])
  @@index([specialty, isDirectoryVisible, status])
  @@index([studioName])
}

model Service {
  id               String           @id @default(uuid()) @db.Uuid
  photographerId   String           @db.Uuid
  name             String           @db.VarChar(191)
  description      String?
  emoji            String?          @db.VarChar(32)
  status           ServiceStatus    @default(ACTIVE)
  displayOrder     Int              @default(0)
  thumbnailAssetId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  analyticsEvents  AnalyticsEvent[]
  analyticsDailyServiceRollups AnalyticsDailyServiceRollup[]
  bookings         Booking[]
  packages         Package[]
  portfolioItems   PortfolioItem[]
  photographer     Photographer     @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  thumbnailAsset   Asset?           @relation("ServiceThumbnailAsset", fields: [thumbnailAssetId], references: [id])

  @@unique([photographerId, name])
  @@index([photographerId, status, displayOrder])
  @@index([createdAt])
}

model Package {
  id              String           @id @default(uuid()) @db.Uuid
  photographerId  String           @db.Uuid
  serviceId       String           @db.Uuid
  name            String           @db.VarChar(191)
  description     String?
  priceCents      Int
  currency        String           @default("USD") @db.VarChar(3)
  durationLabel   String           @db.VarChar(64)
  features        String[]
  status          PackageStatus    @default(ACTIVE)
  isPopular       Boolean          @default(false)
  displayOrder    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  analyticsEvents AnalyticsEvent[]
  bookings        Booking[]
  photographer    Photographer     @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@index([serviceId, status, displayOrder])
  @@index([photographerId, status])
  @@index([priceCents])
}

model PortfolioItem {
  id              String           @id @default(uuid()) @db.Uuid
  photographerId  String           @db.Uuid
  serviceId       String?          @db.Uuid
  assetId         String           @db.Uuid
  title           String?          @db.VarChar(191)
  description     String?
  category        String?          @db.VarChar(64)
  isFeatured      Boolean          @default(false)
  viewsCount      Int              @default(0)
  displayOrder    Int              @default(0)
  capturedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  analyticsEvents AnalyticsEvent[]
  bookings        Booking[]
  asset           Asset            @relation("PortfolioItemAsset", fields: [assetId], references: [id])
  photographer    Photographer     @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id])

  @@unique([photographerId, assetId])
  @@index([photographerId, isFeatured, createdAt])
  @@index([serviceId, createdAt])
  @@index([photographerId, serviceId, createdAt])
  @@index([category])
}

model Booking {
  id               String           @id @default(uuid()) @db.Uuid
  photographerId   String           @db.Uuid
  serviceId        String?          @db.Uuid
  packageId        String?          @db.Uuid
  portfolioItemId  String?          @db.Uuid
  bookedByUserId   String?          @db.Uuid
  status           BookingStatus    @default(PENDING)
  source           BookingSource    @default(WEBSITE)
  clientName       String?          @db.VarChar(191)
  clientEmail      String?          @db.VarChar(320)
  clientPhone      String?          @db.VarChar(32)
  message          String?
  notes            String?
  preferredDate    DateTime?
  preferredTime    String?          @db.VarChar(5)
  quotedPriceCents Int?
  currency         String           @default("USD") @db.VarChar(3)
  whatsappUrl      String?          @db.VarChar(1024)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  analyticsEvents  AnalyticsEvent[]
  bookedByUser     User?            @relation(fields: [bookedByUserId], references: [id])
  package          Package?         @relation(fields: [packageId], references: [id])
  photographer     Photographer     @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  portfolioItem    PortfolioItem?   @relation(fields: [portfolioItemId], references: [id])
  service          Service?         @relation(fields: [serviceId], references: [id])
  notifications    Notification[]

  @@index([photographerId, status, preferredDate])
  @@index([source, createdAt])
  @@index([clientEmail])
  @@index([createdAt])
}

model Availability {
  id             String             @id @default(uuid()) @db.Uuid
  photographerId String             @db.Uuid
  date           DateTime           @db.Date
  status         AvailabilityStatus @default(AVAILABLE)
  note           String?            @db.VarChar(255)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  photographer   Photographer       @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([photographerId, date])
  @@index([photographerId, status])
  @@index([date])
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @db.Uuid
  photographerId         String?             @db.Uuid
  plan                   PlanTier            @default(FREE)
  status                 SubscriptionStatus  @default(ACTIVE)
  provider               TransactionProvider @default(CHIP)
  billingInterval        BillingInterval     @default(MONTHLY)
  providerCustomerId     String?             @db.VarChar(191)
  providerSubscriptionId String?             @unique @db.VarChar(191)
  chipPurchaseId         String?             @unique @db.VarChar(191)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  pendingPlan            PlanTier?
  pendingBillingInterval BillingInterval?
  cancelAtPeriodEnd      Boolean             @default(false)
  canceledAt             DateTime?
  trialEndsAt            DateTime?
  startedAt              DateTime            @default(now())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  notifications          Notification[]
  photographer           Photographer?       @relation(fields: [photographerId], references: [id])
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]

  @@index([userId, status])
  @@index([photographerId, status])
  @@index([plan, status])
  @@index([userId, status, billingInterval])
  @@index([createdAt])
}
model CustomDomain {
  id             String                @id @default(uuid()) @db.Uuid
  photographerId String                @unique @db.Uuid
  domain         String                @unique @db.VarChar(255)
  apexDomain     String                @db.VarChar(255)
  host           String                @db.VarChar(128)
  status         CustomDomainStatus    @default(AWAITING_DNS)
  sslStatus      CustomDomainSslStatus?
  failureReason  String?
  lastCheckedAt  DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  photographer   Photographer          @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([domain, status])
}

model Transaction {
  id                    String              @id @default(uuid()) @db.Uuid
  subscriptionId        String?             @db.Uuid
  userId                String?             @db.Uuid
  provider              TransactionProvider
  providerTransactionId String?             @unique @db.VarChar(191)
  status                TransactionStatus   @default(PENDING)
  amountCents           Int
  currency              String              @default("USD") @db.VarChar(3)
  failureReason         String?
  metadata              Json?
  processedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  subscription          Subscription?       @relation(fields: [subscriptionId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  bookingId      String?          @db.Uuid
  subscriptionId String?          @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(191)
  body           String
  actionUrl      String?          @db.VarChar(1024)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  booking        Booking?         @relation(fields: [bookingId], references: [id])
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([bookingId])
}

model Referral {
  id                     String         @id @default(uuid()) @db.Uuid
  referrerUserId         String         @db.Uuid
  referredUserId         String?        @unique @db.Uuid
  referredPhotographerId String?        @db.Uuid
  referredEmail          String?        @db.VarChar(320)
  code                   String         @db.VarChar(64)
  status                 ReferralStatus @default(CLICKED)
  source                 String?        @db.VarChar(64)
  visitorId              String?        @db.VarChar(191)
  rewardCents            Int            @default(0)
  convertedAt            DateTime?
  rewardGrantedAt        DateTime?
  rewardPlan             PlanTier?
  rewardDays             Int            @default(0)
  trialGrantedAt         DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  referredPhotographer   Photographer?  @relation("ReferralsToPhotographer", fields: [referredPhotographerId], references: [id])
  referredUser           User?          @relation("ReferralsReceived", fields: [referredUserId], references: [id])
  referrerUser           User           @relation("ReferralsSent", fields: [referrerUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, status, createdAt])
  @@index([code, createdAt])
  @@index([referredEmail])
  @@index([visitorId])
}

model Asset {
  id                String          @id @default(uuid()) @db.Uuid
  photographerId    String?         @db.Uuid
  uploadedById      String?         @db.Uuid
  type              AssetType
  purpose           AssetPurpose
  status            AssetStatus     @default(PENDING)
  bucket            String          @db.VarChar(191)
  objectKey         String          @db.VarChar(512)
  cdnUrl            String?         @db.VarChar(1024)
  mimeType          String          @db.VarChar(191)
  originalFileName  String?         @db.VarChar(255)
  sizeBytes         Int
  checksum          String?         @db.VarChar(128)
  width             Int?
  height            Int?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  photographer      Photographer?   @relation("PhotographerAssets", fields: [photographerId], references: [id])
  uploadedBy        User?           @relation("AssetUploader", fields: [uploadedById], references: [id])
  avatarFor         Photographer[]  @relation("PhotographerAvatar")
  bannerFor         Photographer[]  @relation("PhotographerBanner")
  portfolioItems    PortfolioItem[] @relation("PortfolioItemAsset")
  serviceThumbnails Service[]       @relation("ServiceThumbnailAsset")

  @@unique([bucket, objectKey])
  @@index([photographerId, purpose, status])
  @@index([uploadedById, createdAt])
  @@index([deletedAt])
}

model AnalyticsEvent {
  id              BigInt             @id @default(autoincrement())
  eventType       AnalyticsEventType
  photographerId  String?            @db.Uuid
  serviceId       String?            @db.Uuid
  packageId       String?            @db.Uuid
  portfolioItemId String?            @db.Uuid
  bookingId       String?            @db.Uuid
  userId          String?            @db.Uuid
  sessionId       String?            @db.VarChar(128)
  visitorId       String?            @db.VarChar(128)
  source          String?            @db.VarChar(64)
  path            String?            @db.VarChar(512)
  ipHash          String?            @db.VarChar(128)
  userAgent       String?
  referrer        String?            @db.VarChar(1024)
  metadata        Json?
  createdAt       DateTime           @default(now())
  booking         Booking?           @relation(fields: [bookingId], references: [id])
  package         Package?           @relation(fields: [packageId], references: [id])
  photographer    Photographer?      @relation(fields: [photographerId], references: [id])
  portfolioItem   PortfolioItem?     @relation(fields: [portfolioItemId], references: [id])
  service         Service?           @relation(fields: [serviceId], references: [id])
  user            User?              @relation(fields: [userId], references: [id])

  @@index([photographerId, createdAt])
  @@index([eventType, createdAt])
  @@index([photographerId, eventType, createdAt])
  @@index([photographerId, source, createdAt])
  @@index([sessionId, createdAt])
  @@index([visitorId, createdAt])
  @@index([serviceId, packageId])
}

model AnalyticsDailyEventRollup {
  photographerId String             @db.Uuid
  date           DateTime           @db.Date
  eventType      AnalyticsEventType
  source         String             @default("direct") @db.VarChar(64)
  eventCount     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  photographer   Photographer       @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@id([photographerId, date, eventType, source])
  @@index([photographerId, date])
  @@index([photographerId, eventType, date])
}

model AnalyticsDailyServiceRollup {
  photographerId String             @db.Uuid
  date           DateTime           @db.Date
  serviceId      String             @db.Uuid
  eventType      AnalyticsEventType
  eventCount     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  photographer   Photographer       @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  service        Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([photographerId, date, serviceId, eventType])
  @@index([photographerId, date])
  @@index([photographerId, serviceId, eventType, date])
}

model AnalyticsDailyVisitorRollup {
  photographerId String       @db.Uuid
  date           DateTime     @db.Date
  visitorId      String       @db.VarChar(128)
  firstSeenAt    DateTime     @default(now())
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@id([photographerId, date, visitorId])
  @@index([photographerId, date])
}
model AdminLog {
  id           BigInt        @id @default(autoincrement())
  actorUserId  String        @db.Uuid
  targetUserId String?       @db.Uuid
  level        AdminLogLevel @default(INFO)
  action       String        @db.VarChar(128)
  resourceType String        @db.VarChar(64)
  resourceId   String?       @db.VarChar(64)
  ipAddress    String?       @db.VarChar(64)
  userAgent    String?
  statusCode   Int?
  details      Json?
  createdAt    DateTime      @default(now())
  actorUser    User          @relation("AdminActor", fields: [actorUserId], references: [id])
  targetUser   User?         @relation("AdminTargetUser", fields: [targetUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([level, createdAt])
  @@index([action, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CmsContent {
  id              String            @id @default(uuid()) @db.Uuid
  section         CmsContentSection
  slug            String            @db.VarChar(191)
  title           String            @db.VarChar(191)
  excerpt         String?           @db.VarChar(500)
  contentMarkdown String
  status          CmsContentStatus  @default(DRAFT)
  sortOrder       Int               @default(0)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([section, slug])
  @@index([section, status, sortOrder, createdAt])
  @@index([status, publishedAt])
}

enum UserRole {
  PHOTOGRAPHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
  PENDING_INVITE
}

enum PhotographerStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PackageStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELED
  EXPIRED
}

enum BookingSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  DIRECT
  OTHER
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
  BLOCKED
}

enum PlanTier {
  FREE
  PRO
  STUDIO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum TransactionProvider {
  CHIP
  STRIPE
  MANUAL
  OTHER
}

enum CustomDomainStatus {
  PENDING
  AWAITING_DNS
  VERIFYING
  ACTIVE
  FAILED
  BROKEN
}

enum CustomDomainSslStatus {
  PENDING
  ISSUED
  ERROR
}

enum NotificationType {
  SYSTEM
  BOOKING
  BILLING
  SECURITY
  MARKETING
  ADMIN
}

enum ReferralStatus {
  CLICKED
  SIGNED_UP
  CONVERTED
  REWARDED
  CANCELED
}

enum AssetType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

enum AssetPurpose {
  AVATAR
  BANNER
  PORTFOLIO
  SERVICE_THUMBNAIL
  OTHER
}

enum AssetStatus {
  PENDING
  READY
  FAILED
  DELETED
  PURGED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PORTFOLIO_VIEW
  PROFILE_CLICK
  PACKAGE_VIEW
  WHATSAPP_CLICK
  BOOKING_INTENT
  PORTFOLIO_SHARE
  SERVICE_SELECT
  PACKAGE_SELECT
  SEARCH
  FILTER
  OTHER
}

enum AdminLogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum CmsContentSection {
  RESOURCES
  HELP_CENTER
  BLOG
  GUIDES
  ABOUT
  CONTACT
  LEGAL
}

enum CmsContentStatus {
  DRAFT
  PUBLISHED
}



