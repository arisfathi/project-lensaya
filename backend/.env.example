# Lensaya backend environment template
# Copy this file to backend/.env for local development.
# For production, use your deployment secret manager and run: npm run env:check:production

NODE_ENV="development"
PORT=4000
LOG_LEVEL=info
SENTRY_DSN=""
REDIS_URL=""
QUEUE_CONCURRENCY=5
WORKER_CONCURRENCY_ANALYTICS=5
WORKER_CONCURRENCY_EMAIL=5
WORKER_CONCURRENCY_IMAGE_PROCESSING=5
WORKER_CONCURRENCY_NOTIFICATION=5
ASSET_CLEANUP_ENABLED=true
ASSET_CLEANUP_INTERVAL_MS=3600000
BILLING_MAINTENANCE_ENABLED=true
BILLING_MAINTENANCE_INTERVAL_MS=900000
BILLING_MAINTENANCE_BATCH_SIZE=500
NOTIFICATION_REMINDERS_ENABLED=true
NOTIFICATION_REMINDERS_INTERVAL_MS=3600000
NOTIFICATION_REMINDERS_SCAN_BATCH_SIZE=500
APP_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
PUBLIC_URL="http://localhost:5173"
APP_BASE_DOMAIN="localhost"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://app.localhost:5173,http://admin.localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lensaya?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lensaya?schema=public"
DATABASE_POOL_MAX_OVERRIDE=0
DATABASE_POOL_MAX_API=8
DATABASE_POOL_MAX_WORKER=3
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET="replace-with-strong-random-secret"
JWT_ISSUER="lensaya"
JWT_AUDIENCE="lensaya-users"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
PG_BACKUP_DIR="./data/backups/postgres"
PG_BACKUP_RETENTION_DAYS=14
PG_DUMP_BIN="pg_dump"
PG_SNAPSHOT_FILE=""
PG_SNAPSHOT_ALLOW_PARTIAL=false
R2_BACKUP_DATABASE_URL=""
R2_BACKUP_MANIFEST_DIR="./data/backups/r2-manifests"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"

CHIP_API_KEY="replace-with-chip-api-key"
CHIP_API_BASE_URL="https://gate.chip-in.asia/api/v1"
CHIP_WEBHOOK_SECRET="replace-with-chip-webhook-secret"
CHIP_SUCCESS_URL="http://localhost:5173/billing/success"
CHIP_CANCEL_URL="http://localhost:5173/billing/cancel"
CHIP_REQUEST_TIMEOUT_MS=10000
CHIP_MAX_RETRIES=2
CHIP_RETRY_BASE_DELAY_MS=300
CHIP_RETRY_MAX_DELAY_MS=2000
CHIP_BRAND_ID_FREE="replace-with-chip-brand-id-free"
CHIP_BRAND_ID_PRO="replace-with-chip-brand-id-pro"
CHIP_BRAND_ID_STUDIO="replace-with-chip-brand-id-studio"

STRIPE_API_KEY="replace-with-stripe-api-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
STRIPE_SUCCESS_URL="http://localhost:5173/billing/success"
STRIPE_CANCEL_URL="http://localhost:5173/billing/cancel"

BILLING_PROVIDER="auto"
# BILLING_PROVIDER choices:
# - auto: MY -> CHIP, non-MY -> Stripe (recommended)
# - chip: force CHIP for all users
# - stripe: force Stripe for all users
# - mock: local development only (never production)

CUSTOM_DOMAIN_CNAME_TARGET="domains.lensaya.app"
CUSTOM_DOMAIN_VERIFICATION_MODE="mock"
# Set to dns in production
CUSTOM_DOMAIN_LOOKUP_TIMEOUT_MS=4000
MEDIA_TRANSFORM_ENABLED=true
MEDIA_WEB_MAX_WIDTH=1920
MEDIA_THUMB_MAX_WIDTH=640
MEDIA_WEB_QUALITY=82
MEDIA_THUMB_QUALITY=68
FREE_PLAN_WATERMARK_TEXT="Lensaya"
FREE_PLAN_WATERMARK_OPACITY=0.35
LOG_CLIENT_ERRORS=true
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_TTL_SEC=120
WORKER_BACKLOG_WARN_THRESHOLD=20
