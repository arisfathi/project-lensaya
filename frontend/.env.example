# Frontend Environment Variables
# Copy this file to .env and update with your values

# API Configuration
VITE_APP_BASE_DOMAIN=localhost
VITE_API_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=http://localhost:4000

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple (optional)
VITE_APPLE_AUTH_ENABLED=false
# Apple Services ID (must match backend APPLE_CLIENT_ID)
VITE_APPLE_CLIENT_ID=
# Must match backend APPLE_REDIRECT_URI exactly
VITE_APPLE_REDIRECT_URI=http://localhost:5173

# Facebook Pixel (optional, for conversion tracking)
# Get your Pixel ID from https://www.facebook.com/ads/manager/pixel/
# VITE_META_PIXEL_ID=replace-with-facebook-pixel-id

# Production Overrides
# Uncomment these for production build and update the URLs:
# VITE_API_URL=https://app.lensaya.com/api/v1
# VITE_BACKEND_ORIGIN=https://app.lensaya.com
# VITE_META_PIXEL_ID=replace-with-facebook-pixel-id
